<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hyper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Hyper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/hyper_orange</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Hyper</item>
    </style>
</resources>
